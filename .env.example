# ==========================================
# ML Airflow Tekton - Environment Variables
# ==========================================
# IMPORTANT: Ce fichier est un template.
# Copier vers .env et remplir avec vos valeurs réelles.
# NE JAMAIS commiter le fichier .env dans le repository !

# ==========================================
# Airflow Configuration
# ==========================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=KubernetesExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_python_cryptography_fernet
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ==========================================
# Trino/Starburst Configuration
# ==========================================
TRINO_HOST=starburst-coordinator.cluster.local
TRINO_PORT=8080
TRINO_USER=admin
TRINO_PASSWORD=changeme_trino_password
TRINO_CATALOG=hive
TRINO_SCHEMA=default

# ==========================================
# AWS/S3/MinIO Configuration
# ==========================================
AWS_ACCESS_KEY_ID=changeme_aws_access_key
AWS_SECRET_ACCESS_KEY=changeme_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=ml-bucket

# ==========================================
# MLflow Configuration
# ==========================================
MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://ml-bucket/mlflow-artifacts
MLFLOW_USERNAME=admin
MLFLOW_PASSWORD=changeme_mlflow_password

# ==========================================
# Model API Configuration
# ==========================================
MODEL_PATH=/app/models/model.joblib
PREPROCESSOR_PATH=/app/models/preprocessor.joblib
API_PORT=8000
API_HOST=0.0.0.0

# ==========================================
# Tekton Configuration
# ==========================================
TEKTON_DASHBOARD_URL=http://tekton-dashboard:9097
TEKTON_NAMESPACE=tekton-pipelines
TEKTON_PIPELINE_NAME=ml-model-pipeline

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlops
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=changeme_postgres_password

# ==========================================
# Monitoring Configuration
# ==========================================
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# ==========================================
# Kubernetes Configuration
# ==========================================
KUBE_NAMESPACE=default
KUBE_CONFIG_PATH=~/.kube/config
DOCKER_REGISTRY=registry.example.com
DOCKER_REGISTRY_USERNAME=username
DOCKER_REGISTRY_PASSWORD=changeme_registry_password

# ==========================================
# Model Training Configuration
# ==========================================
TRAINING_DATA_PATH=s3://ml-bucket/training-data/
MODEL_OUTPUT_PATH=s3://ml-bucket/models/
VALIDATION_DATA_PATH=s3://ml-bucket/validation-data/
MIN_ACCURACY_THRESHOLD=0.85
MODEL_TYPE=random_forest
N_ESTIMATORS=100
MAX_DEPTH=10

# ==========================================
# Security & Secrets
# ==========================================
# Note: En production, utiliser un gestionnaire de secrets comme:
# - Kubernetes Secrets
# - HashiCorp Vault
# - AWS Secrets Manager
# - Azure Key Vault
SECRET_KEY=changeme_generate_random_secret_key
JWT_SECRET=changeme_jwt_secret_for_api_auth
ENCRYPTION_KEY=changeme_encryption_key

# ==========================================
# Logging & Debugging
# ==========================================
LOG_LEVEL=INFO
DEBUG_MODE=False
ENABLE_METRICS=True
